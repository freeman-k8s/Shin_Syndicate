{
  "name": "shin-syndicate",
  "private": true,
  "version": "0.1.0",
  "description": "A tiny isometric real-time tactical squad game built with Phaser 4, TypeScript and Vite.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
